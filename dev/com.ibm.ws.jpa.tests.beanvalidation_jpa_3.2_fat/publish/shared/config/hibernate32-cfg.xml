<server>
    <featureManager>
        <feature>validation-3.1</feature>
        <feature>jndi-1.0</feature>
        <feature>enterpriseBeansLite-4.0</feature>
        <feature>persistenceContainer-3.2</feature>
        <feature>servlet-6.1</feature>
        <feature>xmlBinding-4.0</feature>
        <feature>componenttest-2.0</feature>
    </featureManager>

    <jpa defaultPersistenceProvider="org.hibernate.jpa.HibernatePersistenceProvider" />

    <library id="HibernateLib">
        <fileset dir="${shared.resource.dir}/jpa_beanvalidation_fat_jpa32_hibernate" includes="*.jar"/>
    </library>

    <!-- START: Hibernate permissions -->
    <javaPermission className="java.security.AllPermission" codebase="${shared.resource.dir}/jpa_beanvalidation_fat_jpa32_hibernate/antlr4-runtime-4.13.2.jar"/>
    <javaPermission className="java.security.AllPermission" codebase="${shared.resource.dir}/jpa_beanvalidation_fat_jpa32_hibernate/byte-buddy-1.17.5.jar"/>
    <javaPermission className="java.security.AllPermission" codebase="${shared.resource.dir}/jpa_beanvalidation_fat_jpa32_hibernate/classmate-1.7.0.jar"/>
    <javaPermission className="java.security.AllPermission" codebase="${shared.resource.dir}/jpa_beanvalidation_fat_jpa32_hibernate/hibernate-community-dialects-7.0.9.Final.jar"/>
    <javaPermission className="java.security.AllPermission" codebase="${shared.resource.dir}/jpa_beanvalidation_fat_jpa32_hibernate/hibernate-core-7.0.9.Final.jar"/>
    <javaPermission className="java.security.AllPermission" codebase="${shared.resource.dir}/jpa_beanvalidation_fat_jpa32_hibernate/hibernate-models-1.0.1.jar"/>
    <javaPermission className="java.security.AllPermission" codebase="${shared.resource.dir}/jpa_beanvalidation_fat_jpa32_hibernate/hibernate-scan-jandex-7.0.9.Final.jar"/>
    <javaPermission className="java.security.AllPermission" codebase="${shared.resource.dir}/jpa_beanvalidation_fat_jpa32_hibernate/jandex-3.3.0.jar"/>
    <javaPermission className="java.security.AllPermission" codebase="${shared.resource.dir}/jpa_beanvalidation_fat_jpa32_hibernate/jboss-logging-3.6.1.Final.jar"/>
    <!-- END: Hibernate permissions -->	
</server>